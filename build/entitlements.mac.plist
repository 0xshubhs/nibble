<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's JIT needs these two under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The ONNX runtime ships as a prebuilt .node signed by someone else.
         Without this, the hardened runtime refuses to load it and the app
         dies at launch with no output at all. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Microphone, for the phase-2 audio capture source. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
